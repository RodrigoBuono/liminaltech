    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"¡Registro exitoso! Te agregamos a la lista de IA Weekly. Cada viernes vas a recibir las 10 noticias más importantes de Inteligencia Artificial.\",\n  \"email\": \"{{ $json.email }}\"\n}",
        "options": {
