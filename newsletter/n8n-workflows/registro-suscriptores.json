{
  "name": "Newsletter IA - Registro de Suscriptores (Webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "registro-newsletter",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "b1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook - Registro",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "registro-newsletter"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').trim().toLowerCase();\nconst nombre = (body.nombre || '').trim();\n\n// Validar email\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (!email || !emailRegex.test(email)) {\n  return [{\n    json: {\n      valido: false,\n      error: 'Email inválido. Por favor ingresá un email correcto.',\n      statusCode: 400\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    email,\n    nombre: nombre || 'Suscriptor',\n    tipo: 'lista',\n    activo: 'true',\n    fecha_registro: new Date().toISOString()\n  }\n}];"
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000001",
      "name": "Validar Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-valid",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1b2c3d4-0003-4000-8000-000000000001",
      "name": "Es Email Valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{$env.GOOGLE_SHEET_NEWSLETTER_URL}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "suscriptores"
        },
        "filters": {
          "conditions": [
            {
              "condition": {
                "left": "email",
                "operation": "equals",
                "right": "={{ $json.email }}"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000001",
      "name": "Verificar Email Existente",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1000, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURAR_GOOGLE_SHEETS_CREDENTIALS",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const validationData = $('Validar Email').first().json;\nconst existingRows = $input.all();\n\nif (existingRows.length > 0 && existingRows[0].json.email) {\n  return [{\n    json: {\n      yaExiste: true,\n      email: validationData.email\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    yaExiste: false,\n    email: validationData.email,\n    nombre: validationData.nombre,\n    tipo: validationData.tipo,\n    activo: validationData.activo,\n    fecha_registro: validationData.fecha_registro\n  }\n}];"
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000002",
      "name": "Verificar si Ya Existe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
