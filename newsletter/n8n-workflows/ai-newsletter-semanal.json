    {
      "parameters": {
        "jsCode": "// Pasar los suscriptores filtrados con el HTML del newsletter\nconst subscribers = $input.all();\nconst newsletterNode = $('Generar HTML del Newsletter').first().json;\n\nreturn subscribers.map(sub => ({\n  json: {\n    email: sub.json.email,\n    nombre: sub.json.nombre || 'Suscriptor',\n    tipo: sub.json.tipo,\n    html: newsletterNode.html.replace('{{NOMBRE}}', sub.json.nombre || 'Suscriptor'),\n    asunto: newsletterNode.asunto\n  }\n}));"
      },
