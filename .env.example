# ─────────────────────────────────────────────────
# GMAIL API (Google Cloud Console)
# ─────────────────────────────────────────────────

# ID de cliente OAuth2 de Google Cloud Console
GOOGLE_CLIENT_ID=tu_client_id_aqui

# Secreto de cliente OAuth2
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# Token de refresh (se genera corriendo: npm run setup)
GOOGLE_REFRESH_TOKEN=tu_refresh_token_aqui

# Tu email de Gmail a monitorear
GMAIL_USER=rodri.epb@gmail.com

# ─────────────────────────────────────────────────
# TWILIO (para enviar WhatsApp)
# ─────────────────────────────────────────────────

# Account SID de tu cuenta Twilio (empieza con AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token de Twilio
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Número de Twilio con WhatsApp habilitado (en formato whatsapp:+549XXXXXXXXXX)
# Este número lo guardás en tu teléfono como "Claudio"
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Tu número de WhatsApp personal (donde querés recibir los mensajes)
MY_WHATSAPP_NUMBER=whatsapp:+549XXXXXXXXXX

# ─────────────────────────────────────────────────
# CONFIGURACIÓN GENERAL
# ─────────────────────────────────────────────────

# Cada cuántos milisegundos revisar el mail (default: 60000 = 1 minuto)
POLL_INTERVAL_MS=60000

# Palabras clave en el asunto para detectar consultas (separadas por coma)
# Si está vacío, notifica para TODOS los emails nuevos
SUBJECT_KEYWORDS=consulta,cotización,pregunta,info,información,quiero,necesito,contact,inquiry

# Dominios o emails a ignorar (separados por coma) - ej: newsletters, no-reply
IGNORE_FROM=no-reply,noreply,newsletter,notifications,mailer-daemon
