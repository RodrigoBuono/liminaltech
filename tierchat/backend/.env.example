# === CONFIGURACIÓN DE TIERCHAT ===
# Copiá este archivo como .env y completá tus valores

# MongoDB - Base de datos
# Creá una cuenta gratis en mongodb.com/atlas
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/tierchat

# JWT - Para autenticación (poné cualquier texto secreto largo)
JWT_SECRET=tu_clave_secreta_super_larga_y_segura_aqui

# Stripe - Para pagos
# Creá una cuenta en stripe.com y buscá tus API keys
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_de_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret

# Firebase - Para notificaciones push
# Descargá el archivo JSON de tu proyecto Firebase
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada\n-----END PRIVATE KEY-----"

# Puerto del servidor
PORT=3000
